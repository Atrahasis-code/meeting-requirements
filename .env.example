# Docker and Compose are the only host runtime requirements.
APP_PORT=8080
MAX_UPLOAD_BYTES=4294967296
FRONTEND_CPUS=0.5
FRONTEND_MEM_LIMIT=256m
BACKEND_CPUS=0.5
BACKEND_MEM_LIMIT=512m
WORKER_CPUS=3.0
WORKER_MEM_LIMIT=3g
WORKER_THREADS=3
ANALYSIS_TIMEOUT_SECONDS=600
INIT_CPUS=0.5
INIT_MEM_LIMIT=256m
DEV_FRONTEND_CPUS=1
DEV_FRONTEND_MEM_LIMIT=512m
# No API keys. Configure ChatGPT OAuth from Settings in the application.
